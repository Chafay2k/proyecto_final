        1280,
        416
      ]
    },
    {
      "parameters": {
        "jsCode": "// 1. Sanitizar y parsear la salida del AI Agent\nlet raw = $input.first().json.output;\nraw = raw.trim().replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/i, '');\nconst data = JSON.parse(raw);\n\nconst requests = [];\nconst put = (placeholder, value) => requests.push({\n  replaceAllText: {\n    containsText: { text: `{{${placeholder}}}`, matchCase: true },\n    replaceText: String(value ?? \"\")\n  }\n});\n\n// 2. Campos de encabezado\nput('fecha_emision', data.fecha_emision);\nput('numero_factura', data.numero_factura);\nput('id_cliente', data.id_cliente);\nput('nombre_cliente', data.nombre_cliente);\nput('fecha_vencimiento', data.fecha_vencimiento);\n\n// 3. Filas de detalle + cálculo de total por fila\nconst precioOficina = Number(data.precio_oficina) || 0;\nconst precioExtra = Number(data.precio_extra) || 0;\n\nlet subtotal = 0;\nlet horasTotales = 0;\n\nfor (let i = 1; i <= 7; i++) {\n  const fila = data.filas?.[i - 1] || {};\n  const horasOficina = Number(fila.horas_oficina) || 0;\n  const horasExtra = Number(fila.horas_extra) || 0;\n  const total = horasOficina * precioOficina + horasExtra * precioExtra;\n\n  subtotal += total;\n  horasTotales += horasOficina + horasExtra;\n\n  put(`consultor_${i}`, fila.consultor ?? '');\n  put(`detalle_trabajo_${i}`, fila.detalle_trabajo ?? '');\n  put(`ticket_${i}`, fila.ticket ?? '');\n  put(`horas_oficina_${i}`, horasOficina || '');\n  put(`horas_extra_${i}`, horasExtra || '');\n  put(`total_${i}`, total || '');\n}\n\n// 4. Totales generales\nconst impuesto = subtotal * 0.21;\nconst total = subtotal + impuesto;\n\nput('subtotal', subtotal);\nput('impuesto', impuesto);\nput('total', total);\n\n// 5. Excedente sobre el abono (no va en la factura, va en el mail al revisor)\nconst abonoMax = Number(data.abono_horas_maximas) || 0;\nconst excedente = Math.max(0, horasTotales - abonoMax);\nconst notaExcedente = excedente > 0\n  ? `⚠️ Este cliente trabajó ${horasTotales}hs, ${excedente}hs por encima del abono contratado (${abonoMax}hs).`\n  : '';\n\n// 6. Salida: requests para el batchUpdate + datos sueltos para el nodo Gmail\nreturn {\n  requests,\n  nombre_cliente: data.nombre_cliente,\n  numero_factura: data.numero_factura,\n  subtotal,\n  impuesto,\n  total,\n  notaExcedente,\n  advertencia: data.advertencia || '',\n  sinHoras: !data.filas || data.filas.length === 0   // no hay horas para facturar\n};\n"
      },
